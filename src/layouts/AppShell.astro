---
import '../index.css'
import React from 'react'
import { renderToString } from 'react-dom/server'
import { App } from '../App'
import { createServerRouter } from '../router'

const {
  title = 'Abhiram | Student | Founder',
  description = 'Student, physics enthusiast, and full-stack engineer building Avenire.space.',
  initialUrl = `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`,
} = Astro.props
const router = createServerRouter(initialUrl)
await router.load()
const appHtml = renderToString(React.createElement(App, { router }))
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/projects/icons/avenire.svg" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      const storedTheme = window.localStorage.getItem('theme')
      const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'dark'
      document.documentElement.classList.toggle('dark', theme === 'dark')
      document.body?.classList.toggle('dark', theme === 'dark')
    </script>
  </head>
  <body class="dark">
    <div id="root" set:html={appHtml} />
    <script>
      import '../main'
    </script>
  </body>
</html>
